---
import AnnouncementBar from './AnnouncementBar.astro';
import SearchBar from './SearchBar.astro';
import CategoryNavigation from './CategoryNavigation.astro';
import MobileDrawer from './MobileDrawer.astro';
import Icon from '../ui/Icon.astro';
import { siteConfig } from '../../data/site';
---

<header class="w-full bg-[#E3DDD3] sticky top-0 z-50 shadow-[0_2px_8px_rgba(0,0,0,0.04)]">
  <!-- Top Announcement Bar -->
  <AnnouncementBar />

  <!-- Main Header - Desktop & Tablet -->
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6 py-2.5 sm:py-3.5">
    <!-- Desktop Row 1 -->
    <div class="flex items-center justify-between gap-4 md:gap-6">
      <!-- Mobile hamburger + Logo -->
      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="mobile-drawer-open"
          aria-label="Ouvrir le menu de navigation"
          class="lg:hidden p-2 -ml-1 text-[#111111] hover:text-[#0066FF] rounded-lg transition-colors"
        >
          <Icon name="Menu" class="w-6 h-6" />
        </button>

        <a href="/" class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0066FF] rounded-lg" aria-label="Accueil MATBAA LIK">
          <img
            src="/assets/logo-symbol.png"
            alt=""
            class="h-[34px] sm:h-[42px] w-auto object-contain transition-transform group-hover:scale-[1.03]"
            width="38"
            height="42"
            loading="eager"
            decoding="async"
          />
          <span class="text-[19px] sm:text-[22px] font-black tracking-tight text-[#111111] leading-none select-none">
            MATBAA LIK
          </span>
        </a>
      </div>

      <!-- CENTER: Main Search Bar (Desktop) -->
      <div class="hidden lg:flex flex-1 justify-center max-w-[560px] mx-2">
        <SearchBar idPrefix="header" class="w-full" />
      </div>

      <!-- RIGHT: Exactly 3 Utility Actions -->
      <div class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">
        <!-- 1. WhatsApp Pill -->
        <a
          href={siteConfig.socials.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 sm:py-2 bg-white hover:bg-[#FAF8F5] text-[#111111] border border-[#111111] rounded-full text-xs font-semibold shadow-sm hover:shadow transition-all active:scale-[0.98]"
        >
          <Icon name="WhatsApp" class="w-4 h-4 flex-shrink-0" />
          <span>WhatsApp</span>
        </a>

        <!-- 2. Service Client Pill + Accessible Dropdown -->
        <div class="relative group/support">
          <button
            type="button"
            id="support-dropdown-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="support-dropdown-panel"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 sm:py-2 bg-white hover:bg-[#FAF8F5] text-[#111111] border border-[#111111] rounded-full text-xs font-semibold shadow-sm hover:shadow transition-all active:scale-[0.98]"
          >
            <Icon name="Phone" class="w-3.5 h-3.5 text-[#111111] flex-shrink-0" strokeWidth={2} />
            <span>Service client</span>
            <Icon name="ChevronDown" class="w-3.5 h-3.5 text-[#555555] transition-transform group-hover/support:rotate-180" />
          </button>

          <!-- Support Dropdown Menu -->
          <div
            id="support-dropdown-panel"
            class="absolute right-0 top-full mt-1.5 w-64 bg-white rounded-2xl shadow-[0_12px_36px_rgba(0,0,0,0.12)] border border-[#E2DDD5] p-3.5 z-50 hidden"
          >
            <div class="text-[11px] font-bold uppercase tracking-wider text-[#888888] mb-2 px-1">
              Assistance & Devis
            </div>
            <div class="space-y-2 text-xs">
              <a
                href={`tel:${siteConfig.phone}`}
                class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-[#F5F2EB] text-[#111111] transition-colors"
              >
                <div class="w-7 h-7 rounded-lg bg-[#0066FF]/10 text-[#0066FF] flex items-center justify-center flex-shrink-0">
                  <Icon name="Phone" class="w-3.5 h-3.5" />
                </div>
                <div>
                  <div class="font-bold text-[#111111]">{siteConfig.phoneDisplay}</div>
                  <div class="text-[10px] text-[#666666]">Appel direct</div>
                </div>
              </a>

              <a
                href={siteConfig.socials.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-[#F5F2EB] text-[#111111] transition-colors"
              >
                <div class="w-7 h-7 rounded-lg bg-[#25D366]/10 text-[#25D366] flex items-center justify-center flex-shrink-0">
                  <Icon name="WhatsApp" class="w-4 h-4" />
                </div>
                <div>
                  <div class="font-bold text-[#111111]">WhatsApp Direct</div>
                  <div class="text-[10px] text-[#666666]">Réponse rapide 7j/7</div>
                </div>
              </a>

              <a
                href={`mailto:${siteConfig.email}`}
                class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-[#F5F2EB] text-[#111111] transition-colors"
              >
                <div class="w-7 h-7 rounded-lg bg-[#111111]/10 text-[#111111] flex items-center justify-center flex-shrink-0">
                  <Icon name="Mail" class="w-3.5 h-3.5" />
                </div>
                <div>
                  <div class="font-bold text-[#111111]">{siteConfig.email}</div>
                  <div class="text-[10px] text-[#666666]">Envoi de fichiers</div>
                </div>
              </a>
            </div>

            <div class="mt-2.5 pt-2 border-t border-[#EFEBE4] text-[10px] text-[#777777] px-1 flex items-center gap-1.5">
              <Icon name="Clock" class="w-3 h-3 text-[#999999]" />
              <span>{siteConfig.workingHours}</span>
            </div>
          </div>
        </div>

        <!-- 3. Devis sur mesure CTA Button -->
        <a
          href="/devis"
          class="inline-flex items-center justify-center px-3.5 sm:px-4 py-1.5 sm:py-2 bg-[#0066FF] hover:bg-[#0052cc] text-white rounded-[10px] text-xs font-semibold shadow-sm hover:shadow transition-all active:scale-[0.98] whitespace-nowrap"
        >
          <span>Devis sur mesure</span>
        </a>
      </div>
    </div>

    <!-- Mobile Row 2: Search Bar full width on mobile -->
    <div class="mt-2.5 lg:hidden">
      <SearchBar idPrefix="mobile-header" class="w-full" />
    </div>
  </div>

  <!-- Row 2: Horizontal Category Navigation (Desktop/Tablet) -->
  <div class="hidden md:block">
    <CategoryNavigation />
  </div>

  <!-- Mobile Drawer -->
  <MobileDrawer />
</header>

<script>
  // Support dropdown toggle
  const supportTrigger = document.getElementById('support-dropdown-trigger');
  const supportPanel = document.getElementById('support-dropdown-panel');

  if (supportTrigger && supportPanel) {
    function toggleSupport(open?: boolean) {
      const isExpanded = open !== undefined ? open : supportTrigger?.getAttribute('aria-expanded') !== 'true';
      supportTrigger?.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      if (isExpanded) {
        supportPanel?.classList.remove('hidden');
      } else {
        supportPanel?.classList.add('hidden');
      }
    }

    supportTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSupport();
    });

    document.addEventListener('click', (e) => {
      if (!supportTrigger.contains(e.target as Node) && !supportPanel.contains(e.target as Node)) {
        toggleSupport(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleSupport(false);
    });
  }
</script>
