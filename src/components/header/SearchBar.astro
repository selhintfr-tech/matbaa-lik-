---
import Icon from '../ui/Icon.astro';
import { CATEGORIES, CANONICAL_PRODUCTS } from '../../data/catalog';

interface Props {
  idPrefix?: string;
  class?: string;
}

const { idPrefix = "desktop", class: className = "" } = Astro.props;

// Pass serialized categories & canonical products data to client script
const searchCategories = CATEGORIES.map(c => ({
  type: 'category' as const,
  title: c.name,
  subtitle: `Catégorie • ${c.submenus.length} sous-groupes`,
  image: c.image,
  keywords: c.keywords,
  url: `/categories/${c.id}/`
}));

const searchProducts = CANONICAL_PRODUCTS.map(p => ({
  type: 'product' as const,
  title: p.title,
  subtitle: p.categoryName,
  image: p.image,
  keywords: [p.title, p.categoryName, ...p.formats, ...p.finishes],
  url: `/produits/${p.slug}/`
}));

const searchData = [...searchCategories, ...searchProducts];
---

<div class={`relative w-full max-w-[540px] ${className}`} data-search-container={idPrefix}>
  <div class="relative flex items-center">
    <div class="absolute left-3.5 text-[#555555] pointer-events-none flex items-center">
      <Icon name="Search" class="w-4 h-4 text-[#666666]" strokeWidth={2} />
    </div>

    <input
      type="search"
      id={`search-input-${idPrefix}`}
      placeholder="Rechercher un produit d'impression, format, packaging..."
      autocomplete="off"
      aria-label="Rechercher un produit d'impression"
      aria-expanded="false"
      aria-controls={`search-results-${idPrefix}`}
      class="w-full h-10 pl-10 pr-9 bg-white text-[#111111] placeholder:text-[#777777] text-xs sm:text-[13px] rounded-full border border-[#D6D0C8] focus:border-[#0066FF] focus:outline-none transition-all shadow-2xs"
    />

    <button
      type="button"
      id={`search-clear-${idPrefix}`}
      aria-label="Effacer la recherche"
      class="absolute right-3 text-[#888888] hover:text-[#111111] hidden p-0.5"
    >
      <Icon name="X" class="w-3.5 h-3.5" />
    </button>
  </div>

  <!-- Search Results Dropdown -->
  <div
    id={`search-results-${idPrefix}`}
    role="listbox"
    class="absolute left-0 right-0 top-full mt-1.5 bg-white rounded-2xl shadow-[0_16px_40px_rgba(0,0,0,0.14)] border border-[#E2DDD5] p-2 z-50 hidden max-h-[400px] overflow-y-auto"
  >
    <div id={`search-items-${idPrefix}`} class="space-y-1">
      <!-- Items populated dynamically via client script -->
    </div>

    <div id={`search-empty-${idPrefix}`} class="hidden p-6 text-center text-xs text-[#666666]">
      <p class="font-medium text-[#111111] mb-1">Aucun résultat trouvé</p>
      <p>Essayez avec d'autres termes comme <em>factures</em>, <em>cartes</em>, <em>flyers</em>, <em>roll-up</em> ou <em>packaging</em>.</p>
    </div>
  </div>
</div>

<script define:vars={{ idPrefix, searchData }}>
  const container = document.querySelector(`[data-search-container="${idPrefix}"]`);
  if (container) {
    const input = container.querySelector(`#search-input-${idPrefix}`);
    const resultsPanel = container.querySelector(`#search-results-${idPrefix}`);
    const resultsItems = container.querySelector(`#search-items-${idPrefix}`);
    const emptyState = container.querySelector(`#search-empty-${idPrefix}`);
    const clearBtn = container.querySelector(`#search-clear-${idPrefix}`);

    let activeIndex = -1;

    function normalize(text) {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function doSearch(query) {
      const q = normalize(query.trim());
      if (!q) {
        resultsPanel.classList.add('hidden');
        clearBtn.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      clearBtn.classList.remove('hidden');

      const matches = searchData.filter(item => {
        const titleMatch = normalize(item.title).includes(q);
        const subMatch = normalize(item.subtitle).includes(q);
        const kwMatch = item.keywords.some(kw => normalize(kw).includes(q));
        return titleMatch || subMatch || kwMatch;
      }).slice(0, 8); // show top 8 results

      resultsItems.innerHTML = '';
      activeIndex = -1;

      if (matches.length === 0) {
        resultsPanel.classList.remove('hidden');
        emptyState.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
      } else {
        emptyState.classList.add('hidden');
        matches.forEach((item, index) => {
          const opt = document.createElement('a');
          opt.href = item.url;
          opt.role = 'option';
          opt.id = `search-opt-${idPrefix}-${index}`;
          opt.className = 'flex items-center gap-3 p-2 rounded-xl hover:bg-[#F5F2EB] transition-colors text-left group';
          opt.innerHTML = `
            <img src="${item.image}" alt="${item.title}" class="w-10 h-10 rounded-lg object-cover border border-[#E8E3DC] flex-shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="text-xs font-bold text-[#111111] group-hover:text-[#0066FF] transition-colors truncate">
                ${item.title}
              </div>
              <div class="text-[11px] text-[#666666] truncate">
                ${item.subtitle}
              </div>
            </div>
            <span class="text-[10px] font-semibold text-[#0066FF] bg-[#F0F5FF] px-2 py-0.5 rounded-full flex-shrink-0">
              ${item.type === 'category' ? 'Catégorie' : 'Produit'}
            </span>
          `;

          opt.addEventListener('click', () => {
            resultsPanel.classList.add('hidden');
            input.setAttribute('aria-expanded', 'false');
          });

          resultsItems.appendChild(opt);
        });

        resultsPanel.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
      }
    }

    input.addEventListener('input', (e) => {
      doSearch(e.target.value);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length > 0) {
        doSearch(input.value);
      }
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      doSearch('');
      input.focus();
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        resultsPanel.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      const items = resultsItems.querySelectorAll('a[role="option"]');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateActiveItem(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateActiveItem(items);
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && items[activeIndex]) {
          e.preventDefault();
          items[activeIndex].click();
        }
      } else if (e.key === 'Escape') {
        resultsPanel.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    function updateActiveItem(items) {
      items.forEach((item, idx) => {
        if (idx === activeIndex) {
          item.classList.add('bg-[#F0EBE1]');
          item.focus();
        } else {
          item.classList.remove('bg-[#F0EBE1]');
        }
      });
    }
  }
</script>
