---
import MegaMenuPromo from './MegaMenuPromo.astro';
import { getPromoBannersForCategory } from '../../data/promos';
import type { Category } from '../../data/catalog';

interface Props {
  category: Category;
}

const { category } = Astro.props;

const hasPromo = getPromoBannersForCategory(category.id).length > 0;
const subCount = category.submenus.length;

// Choose optimal column count depending on whether the promo panel is shown on the right
const gridColsClass = hasPromo
  ? subCount <= 4
    ? "grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3"
    : subCount <= 8
    ? "grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
    : "grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
  : subCount <= 4
    ? "grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
    : subCount <= 8
    ? "grid-cols-2 md:grid-cols-4"
    : "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5";
---

<div class="w-full text-left py-1">
  <!-- Main content area: Submenus grid on left, optional Promo Banner on right -->
  <div class="flex items-start justify-between gap-6">
    <!-- Submenus Multi-Column Grid (No top/bottom clutter) -->
    <div class="flex-1 min-w-0">
      <div class={`grid ${gridColsClass} gap-x-6 gap-y-4 max-h-[460px] overflow-y-auto pr-2 no-scrollbar text-left`}>
        {category.submenus.map((sub) => (
          <div class="space-y-1.5">
            <h4 class="text-xs font-black text-[#172B4D] uppercase tracking-wider pb-1 border-b border-[#EFEBE4] flex items-center justify-between">
              <span>{sub.title}</span>
            </h4>
            <ul class="space-y-0.5 pt-0.5">
              {sub.items.map((item) => (
                <li>
                  <a
                    href={`/produits/${item.slug}/`}
                    class="block text-[11px] sm:text-xs text-[#444444] hover:text-[#0066FF] hover:translate-x-0.5 transition-all py-0.5 line-clamp-1 leading-snug"
                    title={item.label}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Right-Side Promotional Advertising Panel (Clean Canvas area, auto-hidden if no banners) -->
    <MegaMenuPromo categoryId={category.id} />
  </div>
</div>
