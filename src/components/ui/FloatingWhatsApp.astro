---
import Icon from './Icon.astro';
import { siteConfig } from '../../data/site';
---

<!-- Fixed Floating WhatsApp Contact Button matching uploaded screenshot -->
<aside
  id="floating-whatsapp-btn"
  class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 flex items-center select-none pointer-events-auto"
  aria-label="Assistance WhatsApp instantanée"
>
  <!-- Floating Action Button -->
  <a
    href={siteConfig.socials.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactez-nous sur WhatsApp"
    title="Contactez-nous sur WhatsApp"
    class="flex items-center justify-center w-[54px] h-[54px] sm:w-[60px] sm:h-[60px] rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white shadow-[0_4px_16px_rgba(0,0,0,0.22)] hover:shadow-[0_6px_22px_rgba(37,211,102,0.45)] hover:scale-105 active:scale-95 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
  >
    <!-- Official WhatsApp White Icon -->
    <Icon name="WhatsApp" class="w-8 h-8 sm:w-9 sm:h-9 text-white fill-current relative z-10 flex-shrink-0" />
  </a>
</aside>
