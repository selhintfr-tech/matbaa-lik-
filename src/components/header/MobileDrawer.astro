---
import Icon from '../ui/Icon.astro';
import SearchBar from './SearchBar.astro';
import { CATEGORIES } from '../../data/catalog';
import { siteConfig } from '../../data/site';
---

<div id="mobile-drawer-root" class="relative z-50 lg:hidden">
  <!-- Backdrop -->
  <div
    id="mobile-drawer-backdrop"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- Off-canvas panel -->
  <aside
    id="mobile-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Menu de navigation principal"
    class="fixed inset-y-0 left-0 w-full max-w-[360px] bg-[#E3DDD3] shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col z-50 overflow-hidden"
  >
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-[#D6D0C8] bg-[#E3DDD3]">
      <a href="/" class="flex items-center gap-2" aria-label="Accueil MATBAA LIK">
        <img src="/assets/logo-symbol.png" alt="" class="h-[34px] w-auto object-contain" width="30" height="34" loading="eager" />
        <span class="text-[19px] font-black tracking-tight text-[#111111] leading-none select-none">
          MATBAA LIK
        </span>
      </a>
      <button
        type="button"
        id="mobile-drawer-close"
        aria-label="Fermer le menu"
        class="w-9 h-9 rounded-full bg-white border border-[#D6D0C8] flex items-center justify-center text-[#111111] hover:bg-[#F2ECE4] transition-colors"
      >
        <Icon name="X" class="w-5 h-5" />
      </button>
    </div>

    <!-- Search in Drawer -->
    <div class="p-4 border-b border-[#D6D0C8]">
      <SearchBar idPrefix="mobile" />
    </div>

    <!-- Scrollable content -->
    <div class="flex-1 overflow-y-auto p-4 space-y-6">
      <!-- Quick Action Buttons -->
      <div class="space-y-2">
        <a
          href="/devis"
          class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-[#0066FF] hover:bg-[#0052cc] text-white text-xs font-bold rounded-xl shadow-sm transition-colors text-center"
        >
          <span>Devis sur mesure</span>
          <Icon name="ArrowRight" class="w-3.5 h-3.5" />
        </a>

        <div class="grid grid-cols-2 gap-2">
          <a
            href={siteConfig.socials.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 py-2 px-3 bg-white border border-[#D6D0C8] rounded-xl text-xs font-semibold text-[#111111] hover:bg-[#FAF8F5] transition-colors"
          >
            <Icon name="WhatsApp" class="w-4 h-4" />
            <span>WhatsApp</span>
          </a>

          <a
            href={`tel:${siteConfig.phone}`}
            class="flex items-center justify-center gap-2 py-2 px-3 bg-white border border-[#D6D0C8] rounded-xl text-xs font-semibold text-[#111111] hover:bg-[#FAF8F5] transition-colors"
          >
            <Icon name="Phone" class="w-3.5 h-3.5 text-[#0066FF]" />
            <span>Appeler</span>
          </a>
        </div>
      </div>

      <!-- Categories Accordion -->
      <div>
        <div class="flex items-center justify-between mb-2 px-1">
          <h4 class="text-[11px] font-bold uppercase tracking-wider text-[#777777]">
            Nos 14 Catégories
          </h4>
          <span class="text-[10px] text-[#888888]">Catalogue complet</span>
        </div>

        <div class="space-y-1 bg-white/70 backdrop-blur-sm rounded-2xl p-1.5 border border-[#D6D0C8]/80">
          {CATEGORIES.map((cat) => (
            <div class="mobile-cat-group border-b border-[#EBE6DE] last:border-none">
              <button
                type="button"
                class="mobile-cat-trigger w-full flex items-center justify-between py-2 px-2.5 text-left text-xs font-bold text-[#111111] hover:text-[#0066FF] transition-colors"
                aria-expanded="false"
              >
                <div class="flex items-center gap-2.5">
                  <Icon name={cat.iconName} class="w-4 h-4 text-[#0066FF]" strokeWidth={1.8} />
                  <span>{cat.name}</span>
                </div>
                <Icon name="ChevronDown" class="w-3.5 h-3.5 text-[#888888] transition-transform duration-200 mobile-cat-icon" />
              </button>

              <div class="mobile-cat-content hidden pl-6 pr-2 pb-3 pt-1 space-y-3 text-xs text-[#555555]">
                <a
                  href={`/categories/${cat.id}/`}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0066FF] bg-[#F0F5FF] py-1 px-2.5 rounded-lg hover:underline mobile-nav-link"
                >
                  <span>Voir toute la catégorie {cat.shortName}</span>
                  <Icon name="ArrowRight" class="w-3 h-3" />
                </a>

                {cat.submenus.map((sub) => (
                  <div class="space-y-1 border-l-2 border-[#DCD5C9] pl-2.5">
                    <span class="block text-[11px] font-bold text-[#111111]">{sub.title}</span>
                    <ul class="space-y-0.5">
                      {sub.items.map((item) => (
                        <li>
                          <a
                            href={`/produits/${item.slug}/`}
                            class="block py-0.5 text-[11px] text-[#666666] hover:text-[#0066FF] mobile-nav-link line-clamp-1"
                          >
                            • {item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- General Navigation -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-[#777777] mb-2 px-1">
          Navigation
        </h4>
        <ul class="bg-white/70 rounded-2xl p-2 border border-[#D6D0C8]/80 space-y-1 text-xs font-semibold text-[#111111]">
          {siteConfig.navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-2 px-3 rounded-lg hover:bg-[#F2ECE4] hover:text-[#0066FF] transition-colors mobile-nav-link"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Support & Info -->
      <div class="p-3 bg-white/70 rounded-2xl border border-[#D6D0C8]/80 text-xs text-[#555555] space-y-1.5">
        <div class="flex items-center gap-2 font-bold text-[#111111]">
          <Icon name="Clock" class="w-3.5 h-3.5 text-[#0066FF]" />
          <span>Horaires de service</span>
        </div>
        <p class="text-[11px] text-[#666666]">{siteConfig.workingHours}</p>
        <p class="text-[11px] text-[#666666]">{siteConfig.city}, {siteConfig.country}</p>
      </div>
    </div>
  </aside>
</div>

<script>
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const panel = document.getElementById('mobile-drawer-panel');
  const closeBtn = document.getElementById('mobile-drawer-close');
  const openBtn = document.getElementById('mobile-drawer-open');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function openDrawer() {
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    backdrop?.classList.add('opacity-100', 'pointer-events-auto');
    panel?.classList.remove('-translate-x-full');
    panel?.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    backdrop?.classList.remove('opacity-100', 'pointer-events-auto');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    panel?.classList.remove('translate-x-0');
    panel?.classList.add('-translate-x-full');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  navLinks.forEach((l) => l.addEventListener('click', closeDrawer));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('translate-x-0')) {
      closeDrawer();
      openBtn?.focus();
    }
  });

  // Mobile drawer categories accordion
  const catTriggers = document.querySelectorAll('.mobile-cat-trigger');
  catTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const parent = trigger.closest('.mobile-cat-group');
      const content = parent?.querySelector('.mobile-cat-content');
      const icon = trigger.querySelector('.mobile-cat-icon');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        trigger.setAttribute('aria-expanded', 'false');
        content?.classList.add('hidden');
        icon?.classList.remove('rotate-180');
      } else {
        trigger.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
        icon?.classList.add('rotate-180');
      }
    });
  });
</script>
