---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const steps = [
  {
    number: "1",
    title: "1. Envoyez votre demande",
    description: "Choisissez vos options, décrivez votre projet et ajoutez votre fichier si disponible.",
    icon: "FileText",
  },
  {
    number: "2",
    title: "2. Validez le devis et le BAT",
    description: "Nous confirmons le prix et préparons votre visuel pour validation avant impression.",
    icon: "BadgeCheck",
  },
  {
    number: "3",
    title: "3. Recevez votre impression",
    description: "Votre commande est imprimée et livrée partout au Maroc.",
    icon: "Truck",
  },
];
---

<section class="w-full py-6 sm:py-8" aria-label="Comment ça marche">
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6">
    <SectionHeading title="COMMENT ÇA MARCHE ?" />

    <!-- 3 Steps row on desktop with connecting arrows -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 relative items-stretch">
      {steps.map((step, idx) => (
        <div class="relative flex items-center">
          <!-- Step Card (Warm off-white studio aesthetic) -->
          <div class="w-full bg-[#F7F4EF] rounded-xl sm:rounded-card p-4 sm:p-5 border border-[#DCD5C9] shadow-[0_2px_8px_rgba(0,0,0,0.02)] hover:shadow-[0_6px_20px_rgba(0,0,0,0.06)] transition-all flex items-start gap-4 h-full">
            <!-- Icon container -->
            <div class="w-12 h-12 rounded-xl bg-[#0066FF]/10 text-[#0066FF] flex items-center justify-center flex-shrink-0">
              <Icon name={step.icon} class="w-6 h-6 text-[#0066FF]" strokeWidth={2} />
            </div>

            <!-- Content -->
            <div class="flex-1 min-w-0">
              <h3 class="text-sm sm:text-[15px] font-bold text-[#111111] mb-1">
                {step.title}
              </h3>
              <p class="text-xs text-[#555555] leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>

          <!-- Thin connecting arrow between cards (desktop only) -->
          {idx < 2 && (
            <div class="hidden md:flex absolute -right-3.5 lg:-right-4.5 top-1/2 -translate-y-1/2 z-10 text-[#888888]">
              <Icon name="ArrowRight" class="w-4 h-4 text-[#888888]" strokeWidth={2} />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
