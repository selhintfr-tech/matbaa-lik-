---
interface Props {
  title: string;
  actionText?: string;
  actionHref?: string;
  class?: string;
}

const { title, actionText, actionHref, class: className = "" } = Astro.props;
---

<div class={`flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 ${className}`}>
  <div>
    <!-- Orange accent line matching the mockup -->
    <div class="w-8 h-[4px] bg-[#F26522] rounded-full mb-2.5"></div>
    <h2 class="text-xl sm:text-2xl md:text-[26px] font-black uppercase text-[#111111] tracking-tight leading-none">
      {title}
    </h2>
  </div>

  {actionText && actionHref && (
    <a
      href={actionHref}
      class="inline-flex items-center text-sm font-semibold text-white bg-[#0066FF] hover:bg-[#0052cc] px-4 py-2 rounded-[10px] transition-colors self-start sm:self-auto"
    >
      {actionText}
    </a>
  )}
</div>
